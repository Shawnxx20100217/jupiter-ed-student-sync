{
  "name": "jupiter-ed-student-sync",
  "version": "0.2.0",
  "private": true,
  "description": "Independent, read-only student source snapshots for private repositories",
  "license": "MIT",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "demo": "node scripts/demo.cjs",
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node scripts/browser-smoke.cjs",
    "read": "node src/run.cjs",
    "export": "node scripts/export.cjs",
    "ticktick:preview": "node scripts/ticktick-preview.cjs",
    "audit:shareable": "node scripts/audit-shareable.cjs"
  },
  "dependencies": { "puppeteer-core": "25.17.0" },
  "devDependencies": { "@types/node": "24.10.0", "typescript": "5.9.3" }
}
